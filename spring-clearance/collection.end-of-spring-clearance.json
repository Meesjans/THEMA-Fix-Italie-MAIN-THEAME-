{
  "sections": {
    "header": {
      "type": "custom-liquid",
      "name": "Clearance header",
      "settings": {
        "full_width": true,
        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n.esc{--esc-bg:#efe9df;--esc-ink:#141414;--esc-mute:#5c5246;background:var(--esc-bg);color:var(--esc-ink);font-family:\"Nunito Sans\",-apple-system,Arial,sans-serif;margin-top:-24px;margin-bottom:-24px;position:relative}\n.esc *{box-sizing:border-box}\n.esc-wrap{max-width:1240px;margin:0 auto;padding:30px 16px 34px;display:grid;gap:26px}\n.esc-imgs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}\n.esc-imgs a{position:relative;display:block;aspect-ratio:3/4;overflow:hidden;background:#e2d9cb}\n.esc-imgs img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.92)}\n.esc-imgs .esc-tag{position:absolute;left:8px;bottom:8px;background:#fff;color:var(--esc-ink);font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:5px 8px}\n.esc-text{text-align:center}\n.esc-stamp{display:inline-block;border:2px solid var(--esc-ink);padding:6px 14px 5px;font-size:12px;font-weight:900;letter-spacing:.3em;text-transform:uppercase;transform:rotate(-3deg);margin:0 0 16px}\n.esc-title{margin:0;font-family:\"Libre Baskerville\",Georgia,\"Times New Roman\",serif;font-weight:700;font-size:32px;line-height:1.12;letter-spacing:-.01em;color:var(--esc-ink)}\n.esc-title em{display:block;font-style:italic;font-weight:400;font-size:.6em;margin-top:9px;color:var(--esc-mute)}\n.esc-price{margin:18px 0 0;font-size:14px;letter-spacing:.08em;text-transform:uppercase;font-weight:700}\n.esc-price b{font-size:24px;letter-spacing:0;margin:0 4px}\n.esc-copy{max-width:470px;margin:14px auto 0;font-size:15.5px;line-height:1.6;color:#3b342c}\n.esc-tiers{display:flex;border-top:1px solid var(--esc-ink);border-bottom:1px solid var(--esc-ink);margin-top:22px}\n.esc-tiers div{flex:1;padding:12px 4px;text-align:center}\n.esc-tiers div+div{border-left:1px solid var(--esc-ink)}\n.esc-tiers small{display:block;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}\n.esc-tiers strong{display:block;font-family:\"Libre Baskerville\",Georgia,serif;font-size:20px;margin-top:3px}\n.esc-note{margin:10px 0 0;font-size:12.5px;color:var(--esc-mute)}\n.esc-btn{display:inline-block;margin-top:20px;background:var(--esc-ink);color:#fff !important;text-decoration:none;font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;padding:16px 30px}\n@media (max-width:899px){\n  .esc-wrap{padding:18px 14px 20px;gap:14px}\n  .esc-imgs{gap:6px}\n  .esc-imgs a{aspect-ratio:4/5}\n  .esc-imgs .esc-tag{left:5px;bottom:5px;font-size:9px;padding:4px 6px;letter-spacing:.1em}\n  .esc-stamp{font-size:10.5px;padding:4px 11px 3px;margin:0 0 10px}\n  .esc-title{font-size:26px}\n  .esc-title em{margin-top:5px}\n  .esc-price{margin-top:10px;font-size:12.5px}\n  .esc-price b{font-size:20px}\n  .esc-copy{display:none}\n  .esc-tiers{margin-top:12px}\n  .esc-tiers div{padding:8px 4px}\n  .esc-tiers strong{font-size:17px}\n  .esc-note{margin-top:7px;font-size:11.5px}\n  .esc-btn{display:none}\n}\n@media (min-width:900px){\n  .esc-wrap{grid-template-columns:1.15fr 1fr;align-items:center;gap:48px;padding:48px 24px 52px}\n  .esc-text{text-align:left;order:-1}\n  .esc-copy{margin-left:0}\n  .esc-title{font-size:50px}\n  .esc-tiers{max-width:440px}\n}\n</style>\n<div class=\"esc\">\n  <div class=\"esc-wrap\">\n    <div class=\"esc-imgs\">\n      {%- assign esc_best = 'colette-elegant-wrap-midi-dress,evelyn-one-shoulder-floral-maxi,annabel-the-flattering-lace-midi-dress' | split: ',' -%}\n      {%- for h in esc_best -%}\n        {%- assign p = all_products[h] -%}\n        {%- if p and p.featured_image -%}\n          <a href=\"{{ p.url }}\"><img src=\"{{ p.featured_image | image_url: width: 600 }}\" alt=\"{{ p.title | escape }}\" width=\"600\" height=\"800\" loading=\"eager\"><span class=\"esc-tag\">Bestseller</span></a>\n        {%- endif -%}\n      {%- endfor -%}\n    </div>\n    <div class=\"esc-text\">\n      <span class=\"esc-stamp\">Clearance</span>\n      <h1 class=\"esc-title\">End of Spring Clearance<em>our spring collection has to go</em></h1>\n      <p class=\"esc-price\">Up to<b>50% off</b>every spring dress</p>\n      <p class=\"esc-copy\">Spring in Australia is nearly over, so we're clearing out our spring dresses to make room for summer. Every piece is marked down, and the more you take, the more you save.</p>\n      <div class=\"esc-tiers\"><div><small>Buy 2</small><strong>10% off</strong></div><div><small>Buy 3</small><strong>15% off</strong></div><div><small>Buy 4+</small><strong>20% off</strong></div></div>\n      <p class=\"esc-note\">Extra discount applies automatically in your cart. Mix and match anything.</p>\n      <a class=\"esc-btn\" href=\"#esc-shop\">Shop the clearance</a>\n    </div>\n  </div>\n</div>\n<span id=\"esc-shop\"></span>\n"
      }
    },
    "main": {
      "type": "collection",
      "settings": {
        "heading_font_scale": 100,
        "body_font_scale": 100,
        "show_title": false,
        "show_description": false,
        "show_product_count": false,
        "show_sort": false,
        "show_filters": false,
        "products_per_page": 24
      }
    },
    "trust": {
      "type": "trust-points",
      "name": "Trust points",
      "blocks": {
        "point_shipping": {
          "type": "point",
          "settings": {
            "icon": "shipping",
            "icon_size": 56,
            "title": "FREE SHIPPING",
            "text": "<p>We offer free shipping incl. Track & Trace to Australia!</p>"
          }
        },
        "point_moneyback": {
          "type": "point",
          "settings": {
            "icon": "return",
            "icon_size": 56,
            "title": "MONEY BACK GUARANTEE",
            "text": "<p>You have 30 days from receiving your order to decide whether to keep the product or return it.</p>"
          }
        },
        "point_securecheckout": {
          "type": "point",
          "settings": {
            "icon": "secure",
            "custom_icon": "shopify://shop_images/icon-secure-checkout.png",
            "icon_size": 56,
            "title": "SECURE CHECKOUT",
            "text": "<p>Shop with confidence. All payments are encrypted and processed through secure, certified systems.</p>"
          }
        }
      },
      "block_order": [
        "point_shipping",
        "point_moneyback",
        "point_securecheckout"
      ],
      "settings": {
        "heading_font_scale": 100,
        "body_font_scale": 100,
        "color_scheme": "",
        "icon_color": "#000000",
        "custom_typography": true,
        "title_font": "nunito_sans_n6",
        "title_size_desktop": 16,
        "title_size_mobile": 15.2,
        "title_letter_spacing": 0.5,
        "text_font": "nunito_sans_n4",
        "text_size_desktop": 14.7,
        "text_size_mobile": 14.1,
        "text_letter_spacing": 0.3,
        "subheading": "",
        "heading": "",
        "mobile_layout": "stacked",
        "show_section_divider": false
      }
    }
  },
  "order": [
    "header",
    "main",
    "trust"
  ]
}