{%- comment -%}
  Sterling – Copper shop (copper-bracelets collection), clean grid version.
  - Slim deal strip with the stacked-discount tiers (lights up as the set grows).
  - Text category chips, then the product grid straight away (products high on the page).
  - Clean cards: square photo, SAVE xx% tag, BESTSELLER on the first pieces, strike price + sale price, "+ Add to set".
  - Set bar (= cart) fixed at the bottom with set slots, savings and next-tier message.
  - Upsell sheet after every add: "add 1 more & save x%" with one-tap suggestions.
  The set IS the cart (/cart/add.js); totals come from /cart.js, so Shopify's automatic discounts are what the
  shopper sees. Tier lines in the settings must match the automatic discounts in Shopify.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign coll = s.collection
  if coll == blank
    assign coll = collection
  endif
  assign best_handles = ''
  for p in s.bestsellers
    assign best_handles = best_handles | append: '|' | append: p.handle | append: '|'
  endfor
  assign tier_list = s.tiers | split: ','
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet">
<div class="cx" id="cx-{{ sid }}" data-tiers="{{ s.tiers | escape }}" data-initial="{{ s.initial_count }}" data-step="{{ s.more_count }}">

  <div class="cx-deal">
    <div class="cx-deal__head">
      <p class="cx-deal__title">{{ s.heading }}{% if s.badge != blank %} <span class="cx-deal__badge">{{ s.badge }}</span>{% endif %}</p>
      <p class="cx-deal__sub">{{ s.subheading }}</p>
    </div>
    <ol class="cx-tiers" data-cx-ladder>
      {%- for t in tier_list -%}
        {%- assign tp = t | split: ':' -%}
        <li class="cx-tier{% if forloop.last %} is-best{% endif %}" data-n="{{ tp[0] | strip }}">
          {%- if forloop.last -%}<span class="cx-tier__tag">{{ s.best_label }}</span>{%- endif -%}
          <span class="cx-tier__n">Buy {{ tp[0] | strip }}{% if forloop.last %}+{% endif %}</span>
          <span class="cx-tier__pct">{{ tp[1] | strip }} off</span>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.ladder_note != blank -%}<p class="cx-deal__note">{{ s.ladder_note }}</p>{%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="cx-cats" aria-label="Filter pieces">
      {%- for block in section.blocks -%}
        <button type="button" class="cx-cat{% if forloop.first %} is-active{% endif %}" data-cx-cat="{{ block.settings.tag | downcase | strip }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <p class="cx-count"><span data-cx-count>{{ coll.products_count }}</span>&nbsp;{{ s.count_label }}</p>

  {%- assign sug_max = s.suggest_max | default: 100 | times: 100 -%}
  {%- capture copper_ids -%}[{%- paginate coll.products by 250 -%}{%- for p in coll.products -%}{{ p.id }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endpaginate -%}]{%- endcapture -%}
  {%- capture suggest_json -%}[
    {%- assign sc = 0 -%}
    {%- paginate coll.products by 250 -%}
    {%- for p in coll.products -%}
      {%- if sc < 16 and p.available and p.variants.size == 1 and p.featured_image and p.price <= sug_max -%}
        {%- assign v = p.first_available_variant -%}
        {%- if sc > 0 -%},{%- endif -%}
        {"v":{{ v.id }},"t":{{ p.title | json }},"u":{{ p.url | json }},"i":{{ p.featured_image | image_url: width: 240 | json }},"p":{{ v.price }},"c":{{ v.compare_at_price | default: 0 }}}
        {%- assign sc = sc | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- endpaginate -%}
  ]{%- endcapture -%}

  <div class="cx-grid">
    {%- paginate coll.products by 250 -%}
      {%- for p in coll.products -%}
        {%- liquid
          assign v = p.selected_or_first_available_variant
          assign tagstr = p.tags | join: ' ' | downcase
          assign key = '|' | append: p.handle | append: '|'
          assign is_best = false
          if forloop.index <= s.best_count or best_handles contains key
            assign is_best = true
          endif
          assign save = 0
          if v.compare_at_price > v.price
            assign save = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
          endif
        -%}
        <div class="cx-card" data-cx-card data-tags=" {{ tagstr }} "{% if forloop.index > s.initial_count %} hidden{% endif %}>
          <a class="cx-card__media" href="{{ p.url }}">
            {%- if p.featured_image -%}
              {%- if forloop.index <= 4 -%}
                {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '300, 450, 600', sizes: '(max-width: 749px) 47vw, (max-width: 1199px) 31vw, 300px', alt: p.title, class: 'cx-card__img' }}
              {%- else -%}
                {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', decoding: 'async', widths: '300, 450, 600', sizes: '(max-width: 749px) 47vw, (max-width: 1199px) 31vw, 300px', alt: p.title, class: 'cx-card__img' }}
              {%- endif -%}
            {%- endif -%}
            {%- if is_best -%}<span class="cx-card__best{% if s.gold_product != blank and s.gold_product.id == p.id %} cx-card__best--gold{% endif %}">{{ s.badge_text }}</span>{%- endif -%}
            {%- if save > 0 -%}<span class="cx-card__save">Save {{ save }}%</span>{%- endif -%}
          </a>
          <a class="cx-card__title" href="{{ p.url }}">{{ p.title }}</a>
          <p class="cx-card__price">{%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money_with_currency }}</s>{%- endif -%}<span>{{ v.price | money_with_currency }}</span></p>
          {%- if p.available == false -%}
            <button type="button" class="cx-card__btn" disabled>Sold out</button>
          {%- elsif p.variants.size > 1 -%}
            <a class="cx-card__btn" href="{{ p.url }}">{{ s.choose_label }}</a>
          {%- else -%}
            <button type="button" class="cx-card__btn" data-cx-add="{{ v.id }}">{{ s.add_label }}</button>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
  </div>
  <div class="cx-more-wrap"><button type="button" class="cx-more" data-cx-more hidden>Show <span data-cx-more-n></span> more pieces</button></div>

  {%- if s.owner_text != blank -%}
    <div class="cx-owner">
      <p class="cx-owner__title">{{ s.owner_title }}</p>
      <div class="cx-owner__text">{{ s.owner_text }}</div>
      {%- if s.owner_sign != blank -%}<p class="cx-owner__sign">{{ s.owner_sign }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} copper set drawer = the copper cart (opens after every add and when the bar is tapped) {%- endcomment -%}
  <div class="cx-dr" data-cx-dr hidden>
    <div class="cx-dr__bg" data-cx-close></div>
    <div class="cx-dr__panel" role="dialog" aria-modal="true" aria-label="{{ s.drawer_title | escape }}">
      <div class="cx-dr__head">
        <p class="cx-dr__title">{{ s.drawer_title }}</p>
        <button type="button" class="cx-dr__x" data-cx-close aria-label="Close">&times;</button>
      </div>
      <div class="cx-dr__body">
        <p class="cx-dr__msg" data-cx-dr-msg></p>
        <div class="cx-prog" data-cx-prog-dr></div>
        <div class="cx-dr__sug" data-cx-sug-wrap hidden>
          <p class="cx-dr__sugt" data-cx-sug-title></p>
          <div class="cx-dr__row" data-cx-sug></div>
        </div>
        <ul class="cx-dr__items" data-cx-items></ul>
        <p class="cx-dr__other" data-cx-other hidden></p>
      </div>
      <div class="cx-dr__foot">
        <p class="cx-dr__save" data-cx-dr-save></p>
        <a class="cx-dr__go" href="/checkout" data-cx-dr-go>{{ s.checkout_label }}</a>
        <button type="button" class="cx-dr__keep" data-cx-close>{{ s.keep_label }}</button>
      </div>
    </div>
  </div>

  <div class="cx-set" data-cx-set aria-live="polite">
    <button type="button" class="cx-set__left" data-cx-open aria-label="View your set">
      <span class="cx-set__top"><span class="cx-set__label" data-cx-label></span><span class="cx-set__view">View set</span></span>
      <span class="cx-prog cx-prog--bar" data-cx-prog></span>
      <span class="cx-set__msg" data-cx-msg></span>
    </button>
    <a class="cx-set__btn is-disabled" href="/checkout" data-cx-checkout aria-disabled="true">{{ s.empty_button }}</a>
  </div>
  <div class="cx-toast" data-cx-toast role="status" aria-live="polite"></div>
  <script type="application/json" data-cx-suggest>{{ suggest_json }}</script>
  <script type="application/json" data-cx-copper>{{ copper_ids }}</script>
</div>

<style>
  #cx-{{ sid }} { --cx-ink: #161311; --cx-copper: #9a4e28; --cx-copper-2: #b8693d; --cx-red: #a8321b; --cx-muted: #7a6e65; --cx-line: #e2d9cf; --cx-gold: #d4b06a;
    width: 100%; min-width: 0; max-width: 1440px; margin: 0 auto; padding: 0 32px 120px; overflow-x: clip;
    font-family: "Red Hat Display", -apple-system, Arial, sans-serif; color: var(--cx-ink); }
  #cx-{{ sid }} * { box-sizing: border-box; }
  /* deal strip */
  #cx-{{ sid }} .cx-deal { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 28px; align-items: center; margin: 18px 0 14px; padding: 16px 20px; background: #161311; color: #fff; border-radius: 4px; }
  #cx-{{ sid }} .cx-deal__title { margin: 0; font-family: "Libre Baskerville", Georgia, serif; font-size: 21px; font-weight: 700; color: var(--cx-gold); line-height: 1.2; }
  #cx-{{ sid }} .cx-deal__badge { display: inline-block; vertical-align: middle; margin-left: 6px; padding: 3px 9px; border-radius: 999px; background: var(--cx-gold); color: #111; font-family: "Red Hat Display", Arial, sans-serif; font-size: 10.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  #cx-{{ sid }} .cx-deal__sub { margin: 4px 0 0; font-size: 14px; color: rgba(255,255,255,.78); }
  #cx-{{ sid }} .cx-deal__note { grid-column: 1 / -1; margin: 0; font-size: 12px; color: rgba(255,255,255,.6); }
  #cx-{{ sid }} .cx-tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(92px, 1fr)); gap: 8px; }
  #cx-{{ sid }} .cx-tier { position: relative; display: flex; flex-direction: column; align-items: center; padding: 9px 6px 8px; border: 1px solid rgba(212,176,106,.4); border-radius: 4px; background: #241e19; transition: background .25s, border-color .25s, color .25s; }
  #cx-{{ sid }} .cx-tier.is-best { border-color: var(--cx-gold); }
  #cx-{{ sid }} .cx-tier.is-on { background: var(--cx-gold); border-color: var(--cx-gold); color: #111; }
  #cx-{{ sid }} .cx-tier.is-next { border-color: #fff; }
  #cx-{{ sid }} .cx-tier__tag { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--cx-gold); color: #111; font-size: 8.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; padding: 2px 6px; border-radius: 999px; }
  #cx-{{ sid }} .cx-tier__n { font-size: 11px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; opacity: .85; }
  #cx-{{ sid }} .cx-tier__pct { font-size: 17px; font-weight: 700; color: var(--cx-gold); white-space: nowrap; }
  #cx-{{ sid }} .cx-tier.is-on .cx-tier__pct { color: #111; }
  /* categories */
  #cx-{{ sid }} .cx-cats { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px 0 4px; -webkit-overflow-scrolling: touch; }
  #cx-{{ sid }} .cx-cats::-webkit-scrollbar { display: none; }
  #cx-{{ sid }} .cx-cat { flex: 0 0 auto; padding: 8px 15px; border: 1px solid var(--cx-line); border-radius: 999px; background: #fff; font: inherit; font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: #5b4f46; cursor: pointer; }
  #cx-{{ sid }} .cx-cat.is-active { background: var(--cx-ink); border-color: var(--cx-ink); color: #fff; }
  #cx-{{ sid }} .cx-count { display: flex; align-items: center; gap: 10px; margin: 12px 0 14px; font-size: 12px; letter-spacing: .14em; color: var(--cx-muted); text-transform: uppercase; }
  #cx-{{ sid }} .cx-count::after { content: ""; flex: 1; height: 1px; background: var(--cx-line); }
  /* grid + cards */
  #cx-{{ sid }} .cx-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 34px 24px; }
  #cx-{{ sid }} .cx-card { display: flex; flex-direction: column; min-width: 0; content-visibility: auto; contain-intrinsic-size: auto 470px; }
  #cx-{{ sid }} .cx-card[hidden] { display: none !important; }
  #cx-{{ sid }} .cx-card__media { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; background: #ece6de; }
  #cx-{{ sid }} .cx-card__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  @media (hover: hover) { #cx-{{ sid }} .cx-card__media:hover .cx-card__img { transform: scale(1.04); } }
  #cx-{{ sid }} .cx-card__best { position: absolute; top: 10px; left: 10px; background: rgba(22,19,17,.92); color: #fff; font-size: 9.5px; font-weight: 700; letter-spacing: .14em; line-height: 1; padding: 6px 9px 5px; border-radius: 999px; box-shadow: 0 2px 6px rgba(0,0,0,.18); }
  #cx-{{ sid }} .cx-card__best--gold { background: linear-gradient(135deg, #ecd18f 0%, #d4b06a 50%, #b8913f 100%); color: #161311; box-shadow: 0 2px 6px rgba(140,105,40,.3); }
  #cx-{{ sid }} .cx-card__save { position: absolute; top: 0; right: 0; background: var(--cx-copper); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; padding: 6px 9px; }
  #cx-{{ sid }} .cx-card__title { margin: 12px 0 0; font-size: 16px; font-weight: 500; letter-spacing: .02em; line-height: 1.3; color: var(--cx-ink); text-decoration: none; }
  #cx-{{ sid }} .cx-card__price { margin: 5px 0 12px; display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; font-size: 14px; letter-spacing: .03em; }
  #cx-{{ sid }} .cx-card__price s { color: #8f8379; }
  #cx-{{ sid }} .cx-card__price span { color: var(--cx-red); font-weight: 700; }
  #cx-{{ sid }} .cx-card__btn { margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 42px; border: 1px solid var(--cx-ink); border-radius: 2px;
    background: transparent; color: var(--cx-ink); font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; cursor: pointer; touch-action: manipulation; transition: background .2s, color .2s; }
  @media (hover: hover) { #cx-{{ sid }} .cx-card__btn:not([disabled]):hover { background: var(--cx-ink); color: #fff; } }
  #cx-{{ sid }} .cx-card__btn[disabled] { opacity: .45; cursor: default; }
  #cx-{{ sid }} .cx-card__btn.is-added, #cx-{{ sid }} .cx-card__btn.is-added[disabled] { background: #2e6b45; border-color: #2e6b45; color: #fff; opacity: 1; }
  #cx-{{ sid }} .cx-more-wrap { text-align: center; margin-top: 34px; }
  #cx-{{ sid }} .cx-more { min-width: 240px; min-height: 46px; border: 1px solid var(--cx-ink); background: #fff; border-radius: 2px; font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  /* owners note (below the products) */
  #cx-{{ sid }} .cx-owner { max-width: 720px; margin: 46px auto 0; padding: 22px 24px; text-align: center; border-top: 1px solid var(--cx-line); border-bottom: 1px solid var(--cx-line); }
  #cx-{{ sid }} .cx-owner__title { margin: 0 0 6px; font-family: "Libre Baskerville", Georgia, serif; font-size: 18px; }
  #cx-{{ sid }} .cx-owner__text, #cx-{{ sid }} .cx-owner__text p { margin: 0; font-size: 14.5px; line-height: 1.6; color: #4a3f37; }
  #cx-{{ sid }} .cx-owner__sign { margin: 8px 0 0; font-style: italic; color: var(--cx-copper); }
  /* set bar (clean: label, progress line with the tiers, one message, checkout) */
  #cx-{{ sid }} .cx-set { position: fixed; z-index: 40; left: 50%; bottom: 14px; width: min(760px, calc(100% - 16px)); transform: translateX(-50%);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 10px 10px 16px; background: #fff; border: 1.5px solid var(--cx-gold); border-radius: 14px; box-shadow: 0 10px 34px rgba(20,12,6,.22); }
  #cx-{{ sid }} .cx-set.is-bump { animation: cxBump .45s ease; }
  @keyframes cxBump { 0% { transform: translateX(-50%); } 35% { transform: translateX(-50%) translateY(-6px) scale(1.015); } 100% { transform: translateX(-50%); } }
  #cx-{{ sid }} .cx-set__left { display: block; min-width: 0; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: left; cursor: pointer; }
  #cx-{{ sid }} .cx-set__top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  #cx-{{ sid }} .cx-set__label { font-size: 13px; font-weight: 700; letter-spacing: .02em; }
  #cx-{{ sid }} .cx-set__view { font-size: 11.5px; color: var(--cx-muted); text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
  #cx-{{ sid }} .cx-set__msg { display: block; margin: 5px 0 0; font-size: 12.5px; line-height: 1.3; }
  #cx-{{ sid }} .cx-set__msg b, #cx-{{ sid }} .cx-dr__msg b { color: var(--cx-red); }
  #cx-{{ sid }} .cx-set__msg .ok, #cx-{{ sid }} .cx-dr__msg .ok { color: #2e6b45; font-weight: 700; }
  #cx-{{ sid }} .cx-set__btn { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 54px; min-width: 160px; padding: 0 18px; border-radius: 10px;
    background: linear-gradient(90deg, #15100c 0%, #2a1c12 60%, #4b3220 100%); color: #fff; font-size: 15px; font-weight: 700; line-height: 1.2; text-align: center; text-decoration: none; }
  #cx-{{ sid }} .cx-set__btn small { font-size: 12.5px; font-weight: 500; opacity: .9; white-space: nowrap; }
  #cx-{{ sid }} .cx-set__btn small s { opacity: .7; margin-right: 4px; }
  #cx-{{ sid }} .cx-set__btn.is-disabled { background: #cfc8bc; pointer-events: none; }
  /* progress line with tier stops */
  #cx-{{ sid }} .cx-prog { position: relative; display: block; height: 30px; margin: 6px 8px 0 4px; }
  #cx-{{ sid }} .cx-prog__track { position: absolute; left: 0; right: 0; top: 6px; height: 4px; border-radius: 4px; background: #eee5da; }
  #cx-{{ sid }} .cx-prog__fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background: linear-gradient(90deg, var(--cx-copper-2), var(--cx-copper)); transition: width .4s ease; }
  #cx-{{ sid }} .cx-prog__stop { position: absolute; top: 0; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; }
  #cx-{{ sid }} .cx-prog__dot { width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 2px solid #ddcfbf; display: flex; align-items: center; justify-content: center; font-size: 9px; color: #fff; transition: background .25s, border-color .25s; }
  #cx-{{ sid }} .cx-prog__lbl { margin-top: 1px; font-size: 10px; font-weight: 700; color: #9c8f84; white-space: nowrap; }
  #cx-{{ sid }} .cx-prog__stop.is-on .cx-prog__dot { background: var(--cx-copper); border-color: var(--cx-copper); }
  #cx-{{ sid }} .cx-prog__stop.is-on .cx-prog__lbl { color: var(--cx-copper); }
  #cx-{{ sid }} .cx-prog__stop.is-next .cx-prog__dot { border-color: var(--cx-red); box-shadow: 0 0 0 3px rgba(168,50,27,.15); }
  #cx-{{ sid }} .cx-prog__stop.is-next .cx-prog__lbl { color: var(--cx-red); }
  /* copper set drawer (the copper cart) */
  #cx-{{ sid }} .cx-dr { position: fixed; inset: 0; z-index: 2147483000; }
  #cx-{{ sid }} .cx-dr[hidden] { display: none; }
  #cx-{{ sid }} .cx-dr__bg { position: absolute; inset: 0; background: rgba(22,19,17,.45); animation: cxFade .25s ease; }
  @keyframes cxFade { from { opacity: 0; } to { opacity: 1; } }
  #cx-{{ sid }} .cx-dr__panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(440px, 100%); display: flex; flex-direction: column; background: #fbf8f4; box-shadow: -12px 0 40px rgba(20,12,6,.25); animation: cxSlide .3s ease; }
  @keyframes cxSlide { from { transform: translateX(30px); opacity: 0; } to { transform: none; opacity: 1; } }
  #cx-{{ sid }} .cx-dr__head { display: flex; align-items: center; gap: 10px; padding: 16px 18px; background: #161311; }
  #cx-{{ sid }} .cx-dr__title { margin: 0; flex: 1; font-family: "Libre Baskerville", Georgia, serif; font-size: 19px; font-weight: 700; color: var(--cx-gold); }
  #cx-{{ sid }} .cx-dr__x { border: 0; background: rgba(255,255,255,.12); width: 32px; height: 32px; border-radius: 50%; font-size: 20px; line-height: 1; color: #fff; cursor: pointer; }
  #cx-{{ sid }} .cx-dr__body { flex: 1; overflow-y: auto; padding: 16px 18px 8px; -webkit-overflow-scrolling: touch; }
  #cx-{{ sid }} .cx-dr__msg { margin: 0; font-size: 15px; font-weight: 700; line-height: 1.35; }
  #cx-{{ sid }} .cx-dr__body .cx-prog { margin: 10px 10px 4px 6px; }
  #cx-{{ sid }} .cx-dr__items { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--cx-line); }
  #cx-{{ sid }} .cx-it { display: grid; grid-template-columns: 58px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--cx-line); }
  #cx-{{ sid }} .cx-it img { width: 58px; height: 58px; object-fit: cover; border-radius: 6px; background: #ece6de; display: block; }
  #cx-{{ sid }} .cx-it__t { margin: 0; font-size: 14px; font-weight: 500; line-height: 1.3; }
  #cx-{{ sid }} .cx-it__p { margin: 3px 0 0; font-size: 13px; }
  #cx-{{ sid }} .cx-it__p s { color: #8f8379; margin-right: 5px; }
  #cx-{{ sid }} .cx-it__p span { color: var(--cx-red); font-weight: 700; }
  #cx-{{ sid }} .cx-qty { display: flex; align-items: center; border: 1px solid var(--cx-line); border-radius: 999px; background: #fff; }
  #cx-{{ sid }} .cx-qty button { width: 30px; height: 30px; border: 0; background: none; font-size: 16px; cursor: pointer; color: var(--cx-ink); }
  #cx-{{ sid }} .cx-qty span { min-width: 18px; text-align: center; font-size: 13px; font-weight: 700; }
  #cx-{{ sid }} .cx-dr__empty { padding: 18px 0; text-align: center; color: var(--cx-muted); font-size: 14px; }
  #cx-{{ sid }} .cx-dr__other { margin: 10px 0 0; font-size: 12.5px; color: var(--cx-muted); }
  #cx-{{ sid }} .cx-dr__sug { margin-top: 14px; padding: 12px; background: #fff; border: 1px solid var(--cx-line); border-radius: 10px; }
  #cx-{{ sid }} .cx-dr__sugt { margin: 0 0 10px; font-size: 14px; font-weight: 700; }
  #cx-{{ sid }} .cx-dr__sugt b { color: var(--cx-red); }
  #cx-{{ sid }} .cx-dr__row { display: grid; grid-auto-flow: column; grid-auto-columns: 104px; gap: 10px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  #cx-{{ sid }} .cx-dr__row::-webkit-scrollbar { display: none; }
  #cx-{{ sid }} .cx-up__item { display: flex; flex-direction: column; min-width: 0; }
  #cx-{{ sid }} .cx-up__item img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; border-radius: 6px; background: #ece6de; }
  #cx-{{ sid }} .cx-up__name { margin: 6px 0 0; font-size: 12.5px; font-weight: 500; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #cx-{{ sid }} .cx-up__price { margin: 2px 0 6px; font-size: 12px; white-space: nowrap; }
