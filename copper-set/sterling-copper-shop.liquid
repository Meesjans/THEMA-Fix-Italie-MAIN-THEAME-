  #cx-{{ sid }} .cx-up__price span { color: var(--cx-red); font-weight: 700; }
  #cx-{{ sid }} .cx-up__add { min-height: 34px; border: 0; border-radius: 6px; background: var(--cx-ink); color: #fff; font: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer; touch-action: manipulation; }
  #cx-{{ sid }} .cx-up__add[disabled] { opacity: .6; }
  #cx-{{ sid }} .cx-dr__foot { padding: 12px 18px calc(14px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid var(--cx-line); }
  #cx-{{ sid }} .cx-dr__save { margin: 0 0 8px; display: flex; justify-content: space-between; font-size: 13.5px; }
  #cx-{{ sid }} .cx-dr__save b { color: #2e6b45; }
  #cx-{{ sid }} .cx-dr__go { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; border-radius: 10px; background: linear-gradient(90deg, #15100c 0%, #2a1c12 60%, #4b3220 100%); color: #fff; font-size: 15px; font-weight: 700; text-decoration: none; }
  #cx-{{ sid }} .cx-dr__go s { opacity: .65; font-weight: 500; }
  #cx-{{ sid }} .cx-dr__go.is-disabled { background: #cfc8bc; pointer-events: none; }
  #cx-{{ sid }} .cx-dr__keep { display: block; width: 100%; margin-top: 6px; padding: 8px; border: 0; background: none; font: inherit; font-size: 13px; color: var(--cx-muted); text-decoration: underline; cursor: pointer; }
  html.cx-dr-open { overflow: hidden; }
  #cx-{{ sid }} .cx-toast { position: fixed; left: 50%; bottom: 100px; z-index: 42; transform: translate(-50%, 12px); opacity: 0; pointer-events: none; background: #111; color: var(--cx-gold); border: 1px solid var(--cx-gold); border-radius: 999px; padding: 8px 16px; font-size: 13.5px; font-weight: 700; white-space: nowrap; transition: opacity .25s, transform .25s; }
  #cx-{{ sid }} .cx-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  html.cx-bar-on .jda-cart-knop { opacity: 0 !important; pointer-events: none !important; }
  @media (max-width: 1199px) {
    #cx-{{ sid }} .cx-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 899px) {
    #cx-{{ sid }} .cx-deal { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 749px) {
    #cx-{{ sid }} { padding: 0 12px 130px; }
    #cx-{{ sid }} .cx-deal { margin: 12px 0 10px; padding: 12px 12px 11px; gap: 9px; border-radius: 6px; }
    #cx-{{ sid }} .cx-deal__title { font-size: 17px; }
    #cx-{{ sid }} .cx-deal__sub { font-size: 12.5px; margin-top: 3px; }
    #cx-{{ sid }} .cx-deal__note { font-size: 11px; }
    #cx-{{ sid }} .cx-tiers { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 5px; margin-top: 4px; }
    #cx-{{ sid }} .cx-tier { padding: 7px 2px 6px; }
    #cx-{{ sid }} .cx-tier__n { font-size: 9.5px; letter-spacing: .04em; }
    #cx-{{ sid }} .cx-tier__pct { font-size: 14px; }
    #cx-{{ sid }} .cx-tier__tag { font-size: 7.5px; padding: 1px 5px; top: -7px; }
    #cx-{{ sid }} .cx-cat { padding: 7px 12px; font-size: 11px; }
    #cx-{{ sid }} .cx-count { margin: 10px 0 12px; font-size: 11px; }
    #cx-{{ sid }} .cx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 10px; }
    #cx-{{ sid }} .cx-card { contain-intrinsic-size: auto 320px; }
    #cx-{{ sid }} .cx-card__title { margin-top: 9px; font-size: 14.5px; }
    #cx-{{ sid }} .cx-card__price { font-size: 13px; margin-bottom: 9px; }
    #cx-{{ sid }} .cx-card__save { font-size: 8.5px; padding: 5px 6px; letter-spacing: .1em; }
    #cx-{{ sid }} .cx-card__best { top: 7px; left: 7px; font-size: 8px; padding: 5px 7px 4px; letter-spacing: .12em; }
    #cx-{{ sid }} .cx-card__btn { min-height: 40px; font-size: 11.5px; letter-spacing: .08em; }
    #cx-{{ sid }} .cx-set { bottom: 8px; gap: 10px; padding: 8px 8px 8px 12px; }
    #cx-{{ sid }} .cx-set__msg { font-size: 12px; margin-top: 3px; }
    #cx-{{ sid }} .cx-set__view { display: none; }
    #cx-{{ sid }} .cx-dr__panel { top: auto; width: 100%; max-height: 88vh; border-radius: 16px 16px 0 0; overflow: hidden; animation: cxUp .3s ease; }
    @keyframes cxUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
    #cx-{{ sid }} .cx-set__btn { min-width: 0; max-width: 140px; min-height: 50px; padding: 0 12px; font-size: 13.5px; }
    #cx-{{ sid }} .cx-toast { bottom: 84px; }
  }
  @media (prefers-reduced-motion: reduce) { #cx-{{ sid }} * { transition: none !important; animation: none !important; } }
</style>

<script>
  (function () {
    var root = document.getElementById('cx-{{ sid }}');
    if (!root) return;
    var money = {{ shop.money_format | json }};
    var LABELS = { add: {{ s.add_label | json }}, added: {{ s.added_label | json }}, empty: {{ s.empty_button | json }}, go: {{ s.checkout_label | json }}, all: {{ s.unlocked_text | json }} };
    var tiers = (root.getAttribute('data-tiers') || '').split(',').map(function (t) { var p = t.split(':'); return { n: parseInt(p[0], 10), pct: (p[1] || '').trim() }; }).filter(function (t) { return t.n > 0; });
    var maxN = tiers.length ? tiers[tiers.length - 1].n : 5;
    var suggest = []; try { suggest = JSON.parse(root.querySelector('[data-cx-suggest]').textContent); } catch (e) {}
    function fmt(c) { var v = (c / 100).toFixed(2).split('.'); return money.replace(/\{\{\s*\w+\s*\}\}/, v[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + v[1]).replace(/ ?AUD/, ''); }
    function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function pctFor(n) { var r = null; tiers.forEach(function (t) { if (n >= t.n) r = t; }); return r; }
    function nextFor(n) { for (var i = 0; i < tiers.length; i++) if (n < tiers[i].n) return tiers[i]; return null; }

    /* filter + show more */
    var cards = [].slice.call(root.querySelectorAll('[data-cx-card]'));
    var initial = parseInt(root.getAttribute('data-initial'), 10) || 24, step = parseInt(root.getAttribute('data-step'), 10) || 24;
    var more = root.querySelector('[data-cx-more]'), moreN = root.querySelector('[data-cx-more-n]'), countEl = root.querySelector('[data-cx-count]');
    var current = '', shown = initial;
    function apply() {
      var i = 0;
      cards.forEach(function (c) {
        var match = !current || c.getAttribute('data-tags').indexOf(' ' + current + ' ') > -1;
        var hide = !match || i >= shown;
        if (match) i++;
        if (c.hidden !== hide) c.hidden = hide;
      });
      countEl.textContent = i;
      var left = i - shown;
      more.hidden = left <= 0;
      moreN.textContent = Math.min(step, left);
    }
    root.querySelectorAll('[data-cx-cat]').forEach(function (b) {
      b.addEventListener('click', function () {
        root.querySelectorAll('[data-cx-cat]').forEach(function (x) { x.classList.toggle('is-active', x === b); });
        current = b.getAttribute('data-cx-cat'); shown = initial; apply();
      });
    });
    more.addEventListener('click', function () { shown += step; apply(); });
    apply();

    /* the set (= cart). Copper pieces count for the last (copper-only) tier, every piece counts for the others. */
    var copperIds = {}; try { JSON.parse(root.querySelector('[data-cx-copper]').textContent).forEach(function (id) { copperIds[id] = 1; }); } catch (e) {}
    var els = { set: root.querySelector('[data-cx-set]'), label: root.querySelector('[data-cx-label]'), prog: root.querySelector('[data-cx-prog]'), msg: root.querySelector('[data-cx-msg]'), go: root.querySelector('[data-cx-checkout]'),
      dr: root.querySelector('[data-cx-dr]'), drMsg: root.querySelector('[data-cx-dr-msg]'), drProg: root.querySelector('[data-cx-prog-dr]'), items: root.querySelector('[data-cx-items]'), other: root.querySelector('[data-cx-other]'),
      sugWrap: root.querySelector('[data-cx-sug-wrap]'), sugTitle: root.querySelector('[data-cx-sug-title]'), sug: root.querySelector('[data-cx-sug]'), drSave: root.querySelector('[data-cx-dr-save]'), drGo: root.querySelector('[data-cx-dr-go]'), toast: root.querySelector('[data-cx-toast]') };
    var steps = [].slice.call(root.querySelectorAll('.cx-tier'));
    var lastKey = '', added = false, toastT = null, cartIds = {}, lastCart = { item_count: 0, items: [] };
    function showToast(t) { els.toast.textContent = t; els.toast.classList.add('is-on'); clearTimeout(toastT); toastT = setTimeout(function () { els.toast.classList.remove('is-on'); }, 2000); }
    function counts(cart) { var a = 0, c = 0; (cart.items || []).forEach(function (i) { a += i.quantity; if (copperIds[i.product_id]) c += i.quantity; }); return { a: a, c: c }; }
    function have(t, q) { return t === tiers[tiers.length - 1] ? q.c >= t.n : q.a >= t.n; }
    function state(q) {
      var cur = null, next = null;
      tiers.forEach(function (t) { if (have(t, q)) cur = t; });
      for (var i = 0; i < tiers.length; i++) if (!have(tiers[i], q)) { next = tiers[i]; break; }
      var k = next ? (next === tiers[tiers.length - 1] ? next.n - q.c : next.n - q.a) : 0;
      return { cur: cur, next: next, k: k };
    }
    function progHTML(q, st) {
      var shown = Math.min(maxN, Math.max(st.cur ? st.cur.n : 0, Math.min(q.a, maxN - 1), q.c));
      var html = '<span class="cx-prog__track"><span class="cx-prog__fill" style="width:' + (shown / maxN * 100) + '%"></span></span>';
      tiers.forEach(function (t) {
        var cls = (st.cur && t.n <= st.cur.n) ? ' is-on' : (st.next === t ? ' is-next' : '');
        html += '<span class="cx-prog__stop' + cls + '" style="left:' + (t.n / maxN * 100) + '%"><span class="cx-prog__dot">' + (cls === ' is-on' ? '&#10003;' : '') + '</span><span class="cx-prog__lbl">-' + esc(t.pct) + '</span></span>';
      });
      return html;
    }
    function msgHTML(q, st, long) {
      var piece = function (k) { return k + ' more piece' + (k === 1 ? '' : 's'); };
      if (q.a === 0) return 'Add 2 pieces = <b>' + esc(tiers[0] ? tiers[0].pct : '') + ' off</b> your set';
      if (!st.cur) return 'Add ' + piece(st.k) + ' = <b>' + esc(st.next.pct) + ' OFF</b>' + (long ? ' your whole set' : '');
      if (st.next) return long ? '<span class="ok">&#10003; ' + esc(st.cur.pct) + ' off unlocked</span> · ' + piece(st.k) + ' = <b>' + esc(st.next.pct) + ' off</b>'
        : '<span class="ok">&#10003; ' + esc(st.cur.pct) + ' off</span> · ' + st.k + ' more = <b>' + esc(st.next.pct) + ' off</b>';
      return '<span class="ok">&#10003; ' + esc(LABELS.all) + '</span>';
    }
    function priceHTML(cart) { var orig = cart.original_total_price || cart.items_subtotal_price || 0; return (cart.total_discount > 0 ? '<s>' + fmt(orig) + '</s> ' : '') + fmt(cart.total_price); }
    function renderDrawer(cart, q, st) {
      els.drMsg.innerHTML = (added ? (st.cur ? 'Added · ' : '&#10003; Added! ') : '') + msgHTML(q, st, true);
      els.drProg.innerHTML = progHTML(q, st);
      var mine = (cart.items || []).filter(function (i) { return copperIds[i.product_id]; });
      els.items.innerHTML = mine.length ? mine.map(function (i) {
        var img = i.image ? i.image + (i.image.indexOf('?') > -1 ? '&' : '?') + 'width=120' : '';
        return '<li class="cx-it"><img src="' + esc(img) + '" alt="" width="58" height="58" loading="lazy"><div><p class="cx-it__t">' + esc(i.product_title) + '</p><p class="cx-it__p">' + (i.original_line_price > i.final_line_price ? '<s>' + fmt(i.original_line_price) + '</s>' : '') + '<span>' + fmt(i.final_line_price) + '</span></p></div>'
          + '<div class="cx-qty"><button type="button" data-cx-q="' + esc(i.key) + '" data-q="' + (i.quantity - 1) + '" aria-label="Remove one">&minus;</button><span>' + i.quantity + '</span><button type="button" data-cx-q="' + esc(i.key) + '" data-q="' + (i.quantity + 1) + '" aria-label="Add one">+</button></div></li>';
      }).join('') : '<li class="cx-dr__empty">Your copper set is empty</li>';
      var others = q.a - q.c;
      els.other.hidden = others <= 0;
      els.other.textContent = others > 0 ? '+ ' + others + ' other item' + (others === 1 ? '' : 's') + ' in your bag, included at checkout' : '';
      var picks = suggest.filter(function (x) { return !cartIds[x.v]; }).slice(0, 8);
      els.sugWrap.hidden = !picks.length || !st.next;
      if (picks.length && st.next) {
        els.sugTitle.innerHTML = 'Add ' + st.k + ' more piece' + (st.k === 1 ? '' : 's') + ' &amp; get <b>' + esc(st.next.pct) + ' OFF</b> your whole set';
        els.sug.innerHTML = picks.map(function (x) {
          return '<div class="cx-up__item"><a href="' + esc(x.u) + '"><img src="' + esc(x.i) + '" alt="" loading="lazy" width="118" height="118"></a><p class="cx-up__name">' + esc(x.t) + '</p><p class="cx-up__price">' + (x.c > x.p ? '<s>' + fmt(x.c) + '</s>' : '') + '<span>' + fmt(x.p) + '</span></p><button type="button" class="cx-up__add" data-cx-add="' + x.v + '">+ Add</button></div>';
        }).join('');
      }
      var saved = (cart.original_total_price || 0) - (cart.total_price || 0);
      els.drSave.innerHTML = saved > 0 ? '<span>You save</span><b>' + fmt(saved) + '</b>' : '';
      if (q.a > 0) { els.drGo.classList.remove('is-disabled'); els.drGo.innerHTML = esc(LABELS.go) + ' · ' + priceHTML(cart); }
      else { els.drGo.classList.add('is-disabled'); els.drGo.textContent = LABELS.empty; }
    }
    function render(cart) {
      lastCart = cart;
      var q = counts(cart);
      var key = q.a + '|' + cart.total_price + '|' + (cart.items || []).map(function (i) { return i.key + ':' + i.quantity; }).join(',');
      cartIds = {}; (cart.items || []).forEach(function (i) { cartIds[i.variant_id] = 1; });
      if (key === lastKey && !added) return; lastKey = key;
      var st = state(q);
      steps.forEach(function (s, i) { s.classList.toggle('is-on', !!(st.cur && tiers[i] === st.cur)); s.classList.toggle('is-next', !!(st.next && tiers[i] === st.next)); });
      els.label.textContent = 'Your set · ' + q.a + (q.a === 1 ? ' piece' : ' pieces');
      els.prog.innerHTML = progHTML(q, st);
      els.msg.innerHTML = msgHTML(q, st, false);
      if (q.a > 0) {
        els.go.classList.remove('is-disabled'); els.go.removeAttribute('aria-disabled');
        els.go.innerHTML = esc(LABELS.go) + '<small>' + priceHTML(cart) + '</small>';
      } else { els.go.classList.add('is-disabled'); els.go.setAttribute('aria-disabled', 'true'); els.go.textContent = LABELS.empty; }
      renderDrawer(cart, q, st);
      if (added) {
        added = false;
        els.set.classList.remove('is-bump'); void els.set.offsetWidth; els.set.classList.add('is-bump');
        openDr();
      }
    }

    /* drawer */
    function openDr() { els.dr.hidden = false; document.documentElement.classList.add('cx-dr-open'); }
    function closeDr() { els.dr.hidden = true; document.documentElement.classList.remove('cx-dr-open'); }
    root.querySelector('[data-cx-open]').addEventListener('click', function () { renderDrawer(lastCart, counts(lastCart), state(counts(lastCart))); openDr(); });
    root.querySelectorAll('[data-cx-close]').forEach(function (b) { b.addEventListener('click', closeDr); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !els.dr.hidden) closeDr(); });

    var busy = false, queued = false, timer = null;
    function load() {
      if (busy) { queued = true; return; }
      busy = true;
      fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(render).catch(function () {})
        .then(function () { busy = false; if (queued) { queued = false; load(); } });
    }
    function soon() { clearTimeout(timer); timer = setTimeout(load, 200); }
    var selfUpdate = false;
    function refreshOthers() {
      selfUpdate = true; setTimeout(function () { selfUpdate = false; }, 1500);
      try { document.dispatchEvent(new CustomEvent('jd-cart:refresh')); } catch (e) {}
    }
    root.addEventListener('click', function (e) {
      var qb = e.target.closest('[data-cx-q]');
      if (qb) {
        qb.disabled = true; selfUpdate = true;
        fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ id: qb.getAttribute('data-cx-q'), quantity: Math.max(0, parseInt(qb.getAttribute('data-q'), 10)) }) })
          .then(function (r) { return r.json(); }).then(function (c) { lastKey = ''; render(c); refreshOthers(); }).catch(function () { qb.disabled = false; });
        return;
      }
      var add = e.target.closest('[data-cx-add]');
      if (!add || add.disabled) return;
      add.disabled = true;
      var item = [{ id: Number(add.getAttribute('data-cx-add')), quantity: 1 }];
      var inSheet = !!add.closest('[data-cx-dr]');
      selfUpdate = true;
      var req = (window.jdCart && window.jdCart.add) ? window.jdCart.add(item, { open: false }) :
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: item }) }).then(function (r) { if (!r.ok) throw new Error(); });
      var orig = add.textContent;
      Promise.resolve(req).then(function () {
        add.classList.add('is-added'); add.textContent = inSheet ? '✓ Added' : LABELS.added; added = true; load(); refreshOthers();
        setTimeout(function () { add.classList.remove('is-added'); add.textContent = orig; add.disabled = false; }, 1400);
      }).catch(function () {
        selfUpdate = false; add.disabled = false;
        var a = add.closest('[data-cx-card], .cx-up__item'); var l = a && a.querySelector('a'); if (l) window.location.href = l.href;
      });
    });
    render({ item_count: 0, total_price: 0, total_discount: 0, items: [] });
    document.addEventListener('cart:updated', function () { if (!selfUpdate) soon(); });
    document.addEventListener('jd-cart:rendered', function () { if (!selfUpdate) soon(); });
    if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1500 }); else setTimeout(load, 300);
    document.documentElement.classList.add('cx-bar-on');
  })();
</script>

{% schema %}
{
  "name": "Copper shop (clean grid)",
  "tag": "section",
  "class": "section-sterling-copper-shop",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use the collection of the page." },
    { "type": "header", "content": "Deal strip" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pre-Black Friday Sale" },
    { "type": "text", "id": "badge", "label": "Badge next to heading", "default": "Ends today" },
    { "type": "text", "id": "subheading", "label": "Text", "default": "Mix & match any pieces. The more you add, the more you save." },
    { "type": "text", "id": "best_label", "label": "Label on the last step", "default": "Best value" },
    { "type": "text", "id": "ladder_note", "label": "Note under the steps", "default": "Applied automatically at checkout · on top of the sale price" },
    { "type": "header", "content": "Product cards" },
    { "type": "text", "id": "count_label", "label": "Piece count label", "default": "PIECES" },
    { "type": "range", "id": "initial_count", "label": "Pieces shown at first", "min": 8, "max": 60, "step": 4, "default": 24 },
    { "type": "range", "id": "more_count", "label": "Pieces added by 'Show more'", "min": 8, "max": 60, "step": 4, "default": 24 },
    { "type": "range", "id": "best_count", "label": "First pieces with the bestseller badge", "min": 0, "max": 12, "step": 1, "default": 8 },
    { "type": "product_list", "id": "bestsellers", "label": "Extra pieces with the bestseller badge", "limit": 12 },
