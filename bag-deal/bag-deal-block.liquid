{%- assign deal_coll = collections['signature-shoulder-bags'] -%}
{%- capture opts -%}
  {%- for p in deal_coll.products -%}{%- for v in p.variants -%}{%- if v.available -%}
    {%- assign c = p.title | split: '|' | last | strip -%}
    <option value="{{ v.id }}">{{ p.title | split: '|' | first | strip }}{% if p.variants.size > 1 %} · {{ v.title }}{% elsif c != p.title %} · {{ c | remove: ' Crescent Shoulder Bag' | remove: ' Bag' }}{% endif %}</option>
  {%- endif -%}{%- endfor -%}{%- endfor -%}
{%- endcapture -%}
<div class="bdeal" id="bdeal-{{ product.id }}">
  <div class="bdeal__cs">Clearance Sale <span>· while stocks last</span></div><p class="bdeal__sub">The more bags, the more you save</p>
  <div class="bdeal__tiers" role="radiogroup" aria-label="Number of bags">
    <button type="button" class="bdeal__tier" data-n="1" data-total="$69.95"><span class="bdeal__n">1 bag</span><span class="bdeal__each">50% off</span><strong>$69.95</strong></button>
    <button type="button" class="bdeal__tier is-active" data-n="2" data-total="$119.90"><span class="bdeal__n">2 bags</span><span class="bdeal__each">$59.95 each</span><strong>$119.90</strong></button>
    <button type="button" class="bdeal__tier" data-n="3" data-total="$170.85"><span class="bdeal__n">3 bags</span><span class="bdeal__each">$56.95 each</span><strong>$170.85</strong></button>
    <button type="button" class="bdeal__tier" data-n="4" data-total="$211.80"><i>BEST VALUE</i><span class="bdeal__n">4 bags</span><span class="bdeal__each">$52.95 each</span><strong>$211.80</strong></button>
  </div>
  <div class="bdeal__rows">
    {%- for i in (2..4) -%}
      <div class="bdeal__pick" data-row="{{ i }}"{% if i > 2 %} hidden{% endif %}>
        <label for="bdeal-sel-{{ product.id }}-{{ i }}">Bag {{ i }}</label>
        <select id="bdeal-sel-{{ product.id }}-{{ i }}">{{ opts }}</select>
      </div>
    {%- endfor -%}
  </div>
  <button type="button" class="bdeal__btn">Add 2 bags · $119.90</button>
  <p class="bdeal__note">Bag 1 is the colour you have selected above. Your bag discount is applied automatically in the cart.</p>
</div>
<style>.bdeal__cs{margin:-16px -14px 12px;padding:11px 12px;background:#1b1b1b;color:#fff;border-radius:8px 8px 0 0;text-align:center;font-size:12.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.bdeal__cs span{color:#d4b06a;font-weight:600}.bdeal__sub{margin:0 0 12px;text-align:center;font-size:15px;font-weight:600;color:#1b1b1b}
.bdeal{box-sizing:border-box;width:100%;margin:6px 0 4px;padding:16px 14px 14px;border:1.5px solid #b08d4a;border-radius:10px;background:#fbf8f2;color:#1b1b1b}
.bdeal__head{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.bdeal__tag{background:#1b1b1b;color:#d4b06a;font-size:11px;font-weight:700;letter-spacing:.12em;padding:5px 8px;border-radius:4px}
.bdeal__title{font-size:15.5px;font-weight:700}
.bdeal__tiers{display:grid;gap:9px;margin-bottom:12px}
.bdeal__tier{position:relative;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:10px;width:100%;padding:12px;border:1px solid #e6dccb;border-radius:8px;background:#fff;color:#1b1b1b;font:inherit;font-size:15px;text-align:left;cursor:pointer}
.bdeal__tier.is-active{border:2px solid #b08d4a;padding:11px;background:#fffdf8}
.bdeal__tier .bdeal__n{font-weight:600}
.bdeal__tier .bdeal__each{color:#7a6a55;font-size:13px}
.bdeal__tier strong{font-size:15.5px;min-width:72px;text-align:right}
.bdeal__tier i{position:absolute;top:-9px;right:10px;background:#b08d4a;color:#fff;font-style:normal;font-size:10px;font-weight:700;letter-spacing:.1em;padding:3px 7px;border-radius:3px}
.bdeal__tier[data-n="2"] i{background:#1b1b1b;color:#d4b06a}
.bdeal__rows{display:grid;gap:8px;margin-bottom:10px}
.bdeal__pick[hidden]{display:none}
.bdeal__pick label{display:block;font-size:13px;font-weight:600;margin:0 0 4px}
.bdeal__pick select{width:100%;box-sizing:border-box;padding:10px 12px;border:1px solid #cfc4b0;border-radius:8px;background:#fff;font-size:15px;color:#1b1b1b}
.bdeal__btn{width:100%;padding:15px 12px;border:0;border-radius:8px;background:#1b1b1b;color:#fff;font-size:15px;font-weight:700;letter-spacing:.04em;cursor:pointer}
.bdeal__btn[disabled]{opacity:.6}
.bdeal__note{margin:8px 0 0;font-size:12.5px;color:#6b6257;text-align:center;line-height:1.4}
</style>
<script>
(function(){
  var box=document.getElementById('bdeal-{{ product.id }}'); if(!box) return;
  var btn=box.querySelector('.bdeal__btn'), tiers=box.querySelectorAll('.bdeal__tier'), picks=box.querySelectorAll('.bdeal__pick');
  var n=2, total='$119.90';
  var sels=box.querySelectorAll('.bdeal__pick select');
  sels.forEach(function(s,i){ if(s.options.length>i+1) s.selectedIndex=i+1; });
  function label(){ btn.textContent = n===1 ? 'Add 1 bag · $69.95' : 'Add '+n+' bags · '+total; }
  tiers.forEach(function(t){ t.addEventListener('click',function(){
    tiers.forEach(function(x){x.classList.remove('is-active');}); t.classList.add('is-active');
    n=+t.dataset.n; total=t.dataset.total;
    picks.forEach(function(p){ p.hidden = +p.dataset.row > n; });
    label();
  });});
  btn.addEventListener('click',function(){
    var f=document.querySelector('form[action*="/cart/add"] [name="id"]');
    var ids=[+((f&&f.value)||'{{ product.selected_or_first_available_variant.id }}')];
    picks.forEach(function(p){ if(!p.hidden) ids.push(+p.querySelector('select').value); });
    var q={}; ids.forEach(function(id){ q[id]=(q[id]||0)+1; });
    var items=Object.keys(q).map(function(id){ return {id:+id,quantity:q[id]}; });
    btn.disabled=true; var t=btn.textContent; btn.textContent='Adding…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})})
      .then(function(r){ if(!r.ok) throw r; return r.json(); })
      .then(function(){ btn.textContent=t; btn.disabled=false;
        if(window.jdCart&&window.jdCart.open){ document.dispatchEvent(new CustomEvent('jd-cart:refresh')); window.jdCart.open(); } else { location.href='/cart'; } })
      .catch(function(){ btn.textContent='Sorry, one of these bags is unavailable'; setTimeout(function(){ btn.textContent=t; btn.disabled=false; },2500); });
  });
})();
</script>
